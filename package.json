{
  "name": "emopulse-station-cluster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "情绪脉冲站群：稳固共享底座 + 可插拔单 HTML 站点",
  "scripts": {
    "build": "npm run build:sites && npm run build:templates && npm run build:studio",
    "build:all": "npm run build",
    "build:v1": "node shared/build/build.mjs all",
    "build:v1:readable": "node shared/build/build.mjs still --readable",
    "build:readable": "npm run build",
    "dev": "npm run build:sites && npm run serve",
    "build:nexus": "npm run build",
    "verify:core": "node shared/build/verify-core.mjs",
    "verify:stage": "node tests/stage-smoke.mjs && node tests/stage-mutation.mjs && node tests/parts-composition.mjs",
    "verify:preview": "node tests/preview-build.mjs",
    "verify:reuse": "node tests/verify-parts-assembly.mjs && node tests/verify-provenance.mjs && node tests/verify-reuse-wording.mjs && node tests/golden-run.mjs && node tests/mutation-probe.mjs",
    "verify:nexus": "node tests/verify-registry.mjs && node tests/verify-no-core-write.mjs",
    "verify:nexus:full": "node tests/verify-registry.mjs && node tests/verify-no-core-write.mjs && node tests/verify-composition.mjs && node tests/verify-degradation.mjs && node tests/verify-esm-parts.mjs && node tests/verify-analytics.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node shared/stage/preview/build.mjs --preset field",
    "preview:empty": "node shared/stage/preview/build.mjs --preset empty",
    "preview:field": "node shared/stage/preview/build.mjs --preset field",
    "preview:hug": "node shared/stage/preview/build.mjs --preset hug",
    "preview:room": "node shared/stage/preview/build.mjs --preset room",
    "preview:dawn-desk": "node shared/stage/preview/build.mjs --preset dawn-desk",
    "preview:ink": "node shared/stage/preview/build.mjs --preset ink",
    "preview:a2-deepsea": "node shared/stage/preview/build.mjs --preset a2-deepsea",
    "preview:a2-nebula": "node shared/stage/preview/build.mjs --preset a2-nebula",
    "preview:a2-temple": "node shared/stage/preview/build.mjs --preset a2-temple",
    "preview:a2-gate": "node shared/stage/preview/build.mjs --preset a2-gate",
    "preview:bubbles-probe": "node shared/stage/preview/build.mjs --preset bubbles-probe",
    "preview:koi": "node shared/stage/preview/build.mjs --preset koi",
    "preview:koi-nolimit": "node shared/stage/preview/build.mjs --preset koi-nolimit",
    "preview:still": "node shared/stage/preview/build.mjs --preset still",
    "preview:tide-a": "node shared/stage/preview/build.mjs --preset tide-a",
    "preview:tide-b": "node shared/stage/preview/build.mjs --preset tide-b",
    "preview:tide-c": "node shared/stage/preview/build.mjs --preset tide-c",
    "atlas:parts": "node tools/parts/atlas.mjs",
    "build:templates": "node shared/product/build-templates.mjs",
    "build:templates:toy": "node shared/product/build-templates.mjs --platform toy",
    "build:templates:standalone": "node shared/product/build-templates.mjs --platform standalone",
    "build:studio": "node shared/product/studio.mjs",
    "verify:field": "node tests/field-visual.mjs",
    "shot": "node tests/lib/browser.mjs --shot dist/preview/field.html --out dist/preview/shot-field.png",
    "preview:field-l0": "node shared/stage/preview/build.mjs --preset field-l0",
    "verify:paper": "node tests/paper-visual.mjs",
    "verify:input": "node tests/input-boundary.mjs",
    "bench:parts": "node tests/bench-parts-browser.mjs",
    "verify:clock": "node tests/part-clock.mjs",
    "bench:gl": "node tests/bench-gl-composite.mjs",
    "bench:blend": "node tests/bench-blend.mjs",
    "build:sites": "node shared/sites/build.mjs",
    "serve": "node shared/sites/serve.mjs",
    "verify:sites": "node tests/site-build.mjs",
    "verify:site": "node tests/site-visual.mjs",
    "verify:fingerprint": "node tests/site-fingerprint.mjs",
    "verify:dom": "node tests/site-dom.mjs",
    "verify:license": "node tests/license-ritual.mjs && node tests/license-stay.mjs && node tests/license-mobile.mjs",
    "verify:mobile": "node tests/license-mobile.mjs && node tests/hug-release.mjs && node tests/entry-mobile.mjs && node tests/menu-mobile.mjs",
    "verify:state": "node tests/state-source.mjs",
    "verify:readiness": "node tests/readiness-protocol.mjs",
    "probe:still": "node tests/probe-still-resize.mjs",
    "verify:still-takeaway": "node tests/still-takeaway.mjs",
    "verify:koi-keep": "node tests/koi-keep.mjs",
    "verify:license-long": "node tests/license-long-stay.mjs",
    "verify:hug-long": "node tests/hug-long-stay.mjs",
    "verify:long-stay": "node tests/license-long-stay.mjs && node tests/hug-long-stay.mjs",
    "verify:a2": "node tests/a2-studio.mjs && node tests/a2-export.mjs",
    "docs:status": "node tools/docs/status.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@webgpu/types": "^0.1.5",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
