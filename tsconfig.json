{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@contract/*": ["shared/contract/*"],
      "@content/*": ["content/*"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "shared/contract/**/*.ts",
    "shared/stage/**/*.ts",
    "shared/parts/**/*.ts",
    "shared/parts-library/registry/**/*.ts",
    "shared/parts-library/*/part.manifest.ts",
    "shared/parts-library/*/index.ts",
    "shared/parts-library/part-errors.ts",
    "shared/parts-library/legacy-provenance.ts",
    "sites/**/*.ts",
    "content/**/*.ts",
    "tests/fixtures/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "shared/core"]
}
